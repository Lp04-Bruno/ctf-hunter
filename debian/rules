#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_NET_OFFLINE = true
export CARGO_PROFILE_RELEASE_DEBUG = 2
export CARGO_PROFILE_RELEASE_STRIP = false
export npm_config_audit = false
export npm_config_fund = false
export npm_config_update_notifier = false

%:
	dh $@

override_dh_auto_configure:
	python3 scripts/check-release-metadata.py
	python3 scripts/verify-service-lifecycle.py

override_dh_auto_build:
	npm --prefix ui ci --offline --ignore-scripts
	npm --prefix ui run build
	cargo build --release --locked \
		--package ctf-hunter-capture --bin ctf-hunter-capture \
		--package ctf-hunter-setup --bin ctf-hunter-enable-capture \
		--package ctf-hunterd --bins \
		--package ctf-hunter-ui --bin ctf-hunter-ui
	python3 scripts/verify-embedded-ebpf.py \
		target/release/ctf-hunter-capture target/release/build

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --workspace --exclude ctf-hunter-ebpf --locked
	npm --prefix ui run check
	npm --prefix ui test
endif

override_dh_auto_install:
	:

override_dh_install:
	dh_install
	install -Dm0755 target/release/ctf-hunter-ui \
		debian/ctf-hunter/usr/bin/ctf-hunter
	for size in 48 128 256 512; do \
		install -d "debian/ctf-hunter/usr/share/icons/hicolor/$${size}x$${size}/apps"; \
		convert ui/src-tauri/icons/icon.png -resize "$${size}x$${size}" \
			"debian/ctf-hunter/usr/share/icons/hicolor/$${size}x$${size}/apps/dev.ctfhunter.desktop.png"; \
	done

override_dh_missing:
	dh_missing --fail-missing

override_dh_installsystemd:
	dh_installsystemd --restart-after-upgrade ctf-hunter-capture.service

override_dh_installsystemduser:
	dh_installsystemduser ctf-hunterd.service
	dh_installsysusers

override_dh_auto_clean:
	rm -rf ui/dist
	cargo clean
